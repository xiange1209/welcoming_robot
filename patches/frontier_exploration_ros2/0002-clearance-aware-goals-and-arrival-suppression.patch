+TEST(SmartnavClearanceTests, NarrowGapFrontierGetsViewpointOutsideGapOrNone)
+{
+  // A 0.3 m gap (x=13..15) between two 0.6 m wide, 0.7 m deep obstacles; the back of the gap is unknown.
+  // The robot (0.37 m wide) cannot enter; the only usable viewpoint is in the open area above.
+  auto map_msg = build_grid(30, 30, 0);
+  map_msg.info.resolution = 0.1;
+  set_rect(map_msg, 7, 0, 12, 6, 100);
+  set_rect(map_msg, 16, 0, 21, 6, 100);
+  set_rect(map_msg, 13, 0, 15, 2, -1);
+  auto costmap_msg = build_grid(30, 30, 0);
+  costmap_msg.info.resolution = 0.1;
+  const OccupancyGrid2d occupancy_map(map_msg);
+  const OccupancyGrid2d costmap(costmap_msg);
+
+  const auto run = [&](double radius) {
+      FrontierCache frontier_cache(30, 30);
+      std::vector<FrontierPoint *> frontier_points{
+        frontier_cache.getPoint(13, 2), frontier_cache.getPoint(14, 2), frontier_cache.getPoint(15, 2)};
+      FrontierSearchOptions options;
+      options.min_frontier_size_cells = 1;
+      options.candidate_clearance_m = 0.3;
+      options.candidate_search_radius_m = radius;
+      return build_frontier_candidate(
+        frontier_points, {13, 2}, occupancy_map, costmap, std::nullopt,
+        frontier_cache, make_pose(1.5, 2.5), 0.0, options);
+    };
+
+  const auto found = run(1.0);
+  ASSERT_TRUE(found.has_value());
+  ASSERT_TRUE(found->goal_point.has_value());
+  EXPECT_GE(found->goal_point->second, 0.95 - 1e-6);  // above the obstacles (they end at y=0.7)
+  EXPECT_NEAR(found->goal_point->first, 1.45, 0.1 + 1e-6);
+
+  // No cell with enough clearance within 0.3 m of the gap: the frontier is not offered at all.
+  EXPECT_FALSE(run(0.3).has_value());
+}
