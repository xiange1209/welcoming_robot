+TEST(SmartnavClearanceTests, ClearanceTransformMeasuresDistanceToObstaclesUnknownAndEdge)
+{
+  auto map_msg = build_grid(21, 21, 0);
+  map_msg.info.resolution = 0.1;
+  set_cell(map_msg, 10, 10, 100);
+  set_cell(map_msg, 2, 15, -1);
+  auto costmap_msg = build_grid(21, 21, 0);
+  costmap_msg.info.resolution = 0.1;
+  const OccupancyGrid2d occupancy_map(map_msg);
+  const OccupancyGrid2d costmap(costmap_msg);
+  FrontierSearchContext context(occupancy_map, costmap, std::nullopt);
+  // nav_msgs resolution is float32 (0.1 is stored as 0.100000001), hence the 1e-6 tolerances.
+
+  EXPECT_NEAR(context.clearance_m(10, 10), 0.0, 1e-6);
+  EXPECT_NEAR(context.clearance_m(13, 10), 0.3, 1e-6);  // straight: exact
+  EXPECT_NEAR(context.clearance_m(13, 13), 0.4, 1e-6);  // chamfer 3/4 diagonal (true 0.424)
+  EXPECT_NEAR(context.clearance_m(5, 15), 0.3, 1e-6);   // unknown cells count as non-free
+  EXPECT_NEAR(context.clearance_m(0, 5), 0.1, 1e-6);    // the map edge counts too
+}
