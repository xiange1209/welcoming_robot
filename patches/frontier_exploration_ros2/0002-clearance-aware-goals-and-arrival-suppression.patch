+double FrontierSearchContext::clearance_m(int map_x, int map_y)
+{
+  // [smartnav patch] Lazily build a chamfer-3/4 distance transform over the occupancy map:
+  // seeds are every cell that is not FreeSpace (occupied, unknown, or anything in between),
+  // so the result is the distance to the nearest obstacle *or* unexplored cell.
+  // Two raster passes, O(size_x * size_y), once per search pass.
+  if (!clearance_ready_) {
+    constexpr int32_t kFar = std::numeric_limits<int32_t>::max() / 4;
+    const int free_cost = static_cast<int>(OccupancyGrid2d::CostValues::FreeSpace);
+    clearance_chamfer_.assign(static_cast<std::size_t>(size_x_) * static_cast<std::size_t>(size_y_), kFar);
+    for (int y = 0; y < size_y_; ++y) {
+      for (int x = 0; x < size_x_; ++x) {
+        if (occupancy_map_.getCost(x, y) != free_cost) {
+          clearance_chamfer_[cell_index(x, y)] = 0;
+        }
+      }
+    }
+    const auto relax = [this](int nx, int ny, int32_t step, int32_t & best) {
+        if (nx < 0 || ny < 0 || nx >= size_x_ || ny >= size_y_) {
+          return;
+        }
+        best = std::min(best, clearance_chamfer_[cell_index(nx, ny)] + step);
+      };
+    for (int y = 0; y < size_y_; ++y) {
+      for (int x = 0; x < size_x_; ++x) {
+        int32_t & d = clearance_chamfer_[cell_index(x, y)];
+        relax(x - 1, y, 3, d);
+        relax(x - 1, y - 1, 4, d);
+        relax(x, y - 1, 3, d);
+        relax(x + 1, y - 1, 4, d);
+      }
+    }
+    for (int y = size_y_ - 1; y >= 0; --y) {
+      for (int x = size_x_ - 1; x >= 0; --x) {
+        int32_t & d = clearance_chamfer_[cell_index(x, y)];
+        relax(x + 1, y, 3, d);
+        relax(x + 1, y + 1, 4, d);
+        relax(x, y + 1, 3, d);
+        relax(x - 1, y + 1, 4, d);
+      }
+    }
+    clearance_ready_ = true;
+  }
+
+  if (map_x < 0 || map_y < 0 || map_x >= size_x_ || map_y >= size_y_) {
+    return 0.0;
+  }
+  const double resolution = occupancy_map_.map().info.resolution;
+  // The map edge counts as an obstacle: nothing is known beyond it.
+  const int edge_cells = std::min(
+    std::min(map_x + 1, map_y + 1),
+    std::min(size_x_ - map_x, size_y_ - map_y));
+  const double chamfer_cells = static_cast<double>(clearance_chamfer_[cell_index(map_x, map_y)]) / 3.0;
+  return std::min(chamfer_cells, static_cast<double>(edge_cells)) * resolution;
+}
