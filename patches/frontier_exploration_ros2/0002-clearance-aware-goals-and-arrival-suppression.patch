+TEST(SmartnavClearanceTests, ClearanceGoalAvoidsUnseenWallFragment)
+{
+  // Corridor 1.0 m wide at 0.1 m cells: walls on rows 0 and 11. Cells x=20..29 of row 1 are still
+  // unknown (the wall there was only seen at a grazing angle), so the costmap has no inflation there.
+  auto map_msg = build_grid(40, 12, 0);
+  map_msg.info.resolution = 0.1;
+  set_rect(map_msg, 0, 0, 39, 0, 100);
+  set_rect(map_msg, 0, 11, 39, 11, 100);
+  set_rect(map_msg, 20, 1, 29, 1, -1);
+  auto costmap_msg = build_grid(40, 12, 0);
+  costmap_msg.info.resolution = 0.1;
+  const OccupancyGrid2d occupancy_map(map_msg);
+  const OccupancyGrid2d costmap(costmap_msg);
+
+  const auto run = [&](double clearance) {
+      FrontierCache frontier_cache(40, 12);
+      std::vector<FrontierPoint *> frontier_points;
+      for (int x = 20; x <= 29; ++x) {
+        frontier_points.push_back(frontier_cache.getPoint(x, 1));
+      }
+      FrontierSearchOptions options;
+      options.min_frontier_size_cells = 1;
+      options.candidate_clearance_m = clearance;
+      options.candidate_search_radius_m = 1.0;
+      return build_frontier_candidate(
+        frontier_points, {20, 1}, occupancy_map, costmap, std::nullopt,
+        frontier_cache, make_pose(0.5, 0.6), 0.0, options);
+    };
+
+  // Upstream: the goal is the free cell touching the unseen wall (row 2, 0.1 m from it).
+  const auto upstream = run(0.0);
+  ASSERT_TRUE(upstream.has_value());
+  ASSERT_TRUE(upstream->goal_point.has_value());
+  EXPECT_NEAR(upstream->goal_point->second, 0.25, 1e-6);
+
+  // Patched: pulled back to row 4 (0.3 m from the fragment), still alongside it.
+  const auto patched = run(0.3);
+  ASSERT_TRUE(patched.has_value());
+  ASSERT_TRUE(patched->goal_point.has_value());
+  EXPECT_NEAR(patched->goal_point->second, 0.45, 1e-6);
+  EXPECT_GE(patched->goal_point->first, 2.0);
+  EXPECT_LE(patched->goal_point->first, 3.0);
+}
